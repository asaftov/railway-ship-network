# Railway injects DATABASE_URL when you add a Postgres service and reference it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ship_station

# Optional. Enables real channel stats (median views, subscribers) and the video check on bounty entries.
YOUTUBE_API_KEY=

# Required to post agent pick panel results to /api/agent-panel.
ADMIN_TOKEN=change-me

# Public URL of this project's Railway template, once published. Used by the footer badge.
TEMPLATE_URL=

# Referral code attached to the footer badge link.
REFERRAL_CODE=
